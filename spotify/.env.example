# Copy to spotify/.env and fill in. Never commit .env.
# Client ID from https://developer.spotify.com/dashboard (see docs/spotify_api.md)
SPOTIPY_CLIENT_ID=your-client-id-here
# Must exactly match a Redirect URI allowlisted in the dashboard app settings.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080/callback
# Enrichment APIs (see docs/spotify_api.md). Free keys:
# https://getsongbpm.com/api (backlink to getsongbpm.com REQUIRED in project)
GETSONGBPM_API_KEY=
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
