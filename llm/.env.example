# Copy to llm/.env; never commit credentials.
# Default backend:
OPENROUTER_API_KEY=

# --backend local: forwarded Claude router; --model is required.
# Model aliases: local-deepseek, local-qwen, local-gemma, local-gemma-bf16.
LOCAL_LLM_BASE_URL=http://127.0.0.1:18088/v1
# Optional bearer authentication for other compatible local servers:
LOCAL_LLM_API_KEY=
