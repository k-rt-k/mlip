# Copy to peer/.env and fill in. Never commit .env.
# Preferred: a 7-day bearer token minted by peer/scripts/openreview_login.py
# (it prompts for your password once and writes only the token here).
OPENREVIEW_TOKEN=your-token-here
# Fallback: your openreview.net login. Anonymous API reads are blocked.
OPENREVIEW_USERNAME=you@example.com
#OPENREVIEW_PASSWORD=your-password-here
