[Unit]
Description=Playlist Lab public paired study
Wants=playlist-lab-retrieval.service
After=playlist-lab-retrieval.service

[Service]
User=playlist-lab
WorkingDirectory=/opt/playlist-lab/app
Environment=MLIP_STUDY_DB=/var/lib/playlist-lab/live.sqlite
Environment=MLIP_YTM_AUTH_FILE=/etc/playlist-lab/browser.json
Environment=MLIP_SECURE_COOKIE=1
EnvironmentFile=/etc/playlist-lab/app.env
UMask=0077
TimeoutStartSec=180
ExecStartPre=/usr/bin/curl -fsS --output /dev/null --retry 60 --retry-delay 2 --retry-max-time 150 --retry-all-errors --max-time 4 http://127.0.0.1:8061/health
ExecStart=/opt/playlist-lab/app/.venv/bin/waitress-serve --listen=127.0.0.1:8063 --call evaluation_app.app:create_public_study
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
